{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/require_skip_ci.py\" bash" }
        ]
      },
      {
        "matcher": "mcp__github__create_or_update_file|mcp__github__push_files|mcp__github__delete_file",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/require_skip_ci.py\" message" }
        ]
      },
      {
        "matcher": "mcp__github__create_pull_request|mcp__github__update_pull_request",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/require_skip_ci.py\" title" }
        ]
      },
      {
        "matcher": "mcp__github__merge_pull_request",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/require_skip_ci.py\" commit_title" }
        ]
      }
    ]
  }
}
